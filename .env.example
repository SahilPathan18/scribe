# Get your free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Port to run on (defaults to 3000)
PORT=3000

# Gemini Model configuration (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# JWT Secret for Multi-User Authentication (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Production External URL (for keep-alive and share links)
APP_URL=http://localhost:3000

# Supabase PostgreSQL Database (Optional — if omitted, local data/db.json is used)
# Retrieve from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use the service_role secret key for full backend database access:
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
